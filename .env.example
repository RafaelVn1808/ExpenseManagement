# Copie este arquivo para .env e preencha com seus valores.
# Nunca commite o .env (ele está no .gitignore).

# PostgreSQL (Supabase ou container local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expense

# Connection string Supabase: use DATABASE_URL do painel Supabase (Settings > Database)
# ConnectionStrings__DefaultConnection=postgresql://...

# API e Web
JWT_KEY=UmaChaveSecretaComPeloMenos32Caracteres!!

# Supabase Storage (Dashboard > Settings > API: use a service_role key)
# Supabase__Url=https://seu-projeto.supabase.co
# Supabase__ServiceRoleKey=sua-chave-service-role
# Supabase__StorageBucket=expense-images

# CORS (origens separadas por ; ex.: https://app.vercel.app;https://outro-dominio.com)
# Cors__AllowedOrigins=https://seu-front.vercel.app

# Hosts permitidos (separados por ;)
# AllowedHosts=seu-front.vercel.app;api.seudominio.com

# Opcionais
ASPNETCORE_ENVIRONMENT=Development
PUBLIC_BASE_URL=http://localhost:8080
SERVICE_URI_EXPENSE_API=http://localhost:8080
